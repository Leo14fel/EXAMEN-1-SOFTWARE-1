APP_NAME=Examen SW1 API
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Legacy SQL source / controlled rollback; normal CASE persistence is MongoDB.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/examen_sw1
PERSISTENCE_BACKEND=mongodb
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=480

# MongoDB connection is also used by the application when selected above.
# Proof tools require a database ending in _cu25_probe; the app supports generic names.
# Do not put real credentials in this example or commit backend/.env.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
# MONGODB_DATABASE=examen_sw1_cu25_probe
# MONGODB_TIMEOUT_MS=5000

